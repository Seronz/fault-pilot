{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Incident Rate (per source)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(faultpilot_incidents_total[5m]))", "legendFormat": "incidents/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Incident Rate by Source",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (source) (rate(faultpilot_incidents_total[5m]))", "legendFormat": "{{source}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Policy Rejection Rate by Reason",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (reason) (rate(faultpilot_policy_rejections_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Executor Latency (p95)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, executor) (rate(faultpilot_executor_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{executor}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Actions by Executor / Status",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (executor, status) (rate(faultpilot_actions_total[5m]))", "legendFormat": "{{executor}} / {{status}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker Queue Depth",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "faultpilot_worker_queue_depth", "legendFormat": "queue depth", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Self Health (targets up)",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "up{job=~\"faultpilot.*\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Action Error Rate",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(faultpilot_actions_total{status=\"failed\"}[5m])) / clamp_min(sum(rate(faultpilot_actions_total{status=~\"success|failed\"}[5m])), 0.0001)", "legendFormat": "error rate", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.5 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Events Dropped",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(faultpilot_events_dropped_total[5m]))", "legendFormat": "dropped", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["fault-pilot", "sre"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Fault Pilot - Observability",
  "uid": "faultpilot-observability",
  "version": 1,
  "refresh": "30s"
}
